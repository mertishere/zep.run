generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
    provider = "postgresql"
}

model user {
    id          String     @id @default(uuid())
    created_at  DateTime   @default(now())
    updated_at  DateTime   @updatedAt
    username    String     @unique
    email       String     @unique
    password    String
    is_verified Boolean    @default(false)
    packages    zpackage[]
    releases    release[]
    sessions    session[]
    verifies    verify[]
}

model zpackage {
    id          String   @id @default(uuid())
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    name        String   @unique
    description String   @default("")
    docs        String   @default("")
    tags        String   @default("")

    userId   String
    user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
    releases release[]

    @@map("package")
}

model release {
    id          String   @id @default(uuid())
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    release     String
    zig_version String
    url         String
    hash        String
    root_file   String

    userId    String
    user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
    packageId String
    package   zpackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model session {
    id         String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    secret     String

    userId String
    user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum verification_type {
    email
    password
}

model verify {
    id         String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    code       String

    userId String
    user   user              @relation(fields: [userId], references: [id], onDelete: Cascade)
    type   verification_type @default(email)
}
