<div class="release">
	<h1>
		<%= release.version %> 
	</h1>
	<p>
		Zig Version: <%= release.zig_version %> 
	</p>
	<p>
		Root File: <%= release.root_file %> 
	</p>
	<p class="url" title="<%= release.url %>">
		Url (hash): <%= release.url.substring(0, 20) %>...<%= release.url.substring(release.url.length - 20) %> 
		<span>(<%= release.sha256sum %>)</span> 
	</p>
</div>